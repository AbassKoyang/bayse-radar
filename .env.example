# --- Bayse ---------------------------------------------------------------
# Comma-separated event UUIDs to watch. Defaults to the 2027 Nigerian
# presidential election event if unset.
BAYSE_EVENT_IDS=c03ea595-a209-4fe9-a0e1-bd77f3154927

# false -> alert only on the event IDs above.
# true  -> alert on every Bayse market (the global activity feed is always
#          subscribed for reliability; this controls whether it is filtered).
BAYSE_ALL_MARKETS=True

# Alert when the NGN value of a filled order is strictly above this amount.
MIN_ORDER_NGN=1000

# Fallback NGN-per-USD rate. A live rate is fetched from open.er-api.com and
# refreshed periodically; this value is used if that request fails.
USD_NGN_FALLBACK=1500

# How often to refresh the USD/NGN rate, in seconds (default 6 hours).
FX_REFRESH_SECONDS=21600

# --- X / Twitter ---------------------------------------------------------
# Create these in the X developer portal. The app needs "Read and write"
# permission, and the access token must be generated AFTER that permission
# is enabled (otherwise posting returns 403).
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# true  -> log tweets instead of posting them (safe local testing)
# false -> post to X
# If omitted, dry-run is enabled automatically when credentials are missing.
TWITTER_DRY_RUN=

# --- Runtime -------------------------------------------------------------
STATE_DB=data/whale_radar.sqlite3
LOG_LEVEL=INFO

# Connection behaviour.
RECONNECT_BASE_SECONDS=5
RECONNECT_MAX_SECONDS=60
# 0 = retry forever
RECONNECT_MAX_ATTEMPTS=0
